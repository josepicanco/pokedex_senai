{
  "name": "pokedex_senai",
  "version": "1.0.0",
  "description": "Aplicacao de terminal que consulta a PokeAPI e organiza Pokemon em um catalogo local",
  "main": "dist/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "start": "node dist/main.js",
    "dev": "tsc && tsx --watch src/main.ts"
  },
  "keywords": ["pokeapi", "typescript", "nodejs"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^22.19.19",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "node-fetch": "^3.3.2"
  }
}
